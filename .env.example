# Copia questo file in `.env` e inserisci i valori del tuo progetto Firebase
# (Console Firebase > Impostazioni progetto > Le tue app > Configurazione SDK).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Metti a true per lavorare con la Firebase Emulator Suite (npm run emulators).
VITE_USE_EMULATORS=false
